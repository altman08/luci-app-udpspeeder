#!/bin/sh /etc/rc.common
START=90
STOP=10
USE_PROCD=1

. /usr/share/udpspeeder-luci/common.sh

start_instance() {
	local cfg="$1" enabled
	valid_id "$cfg" || return 1
	config_get_bool enabled "$cfg" enabled 0
	[ "$enabled" = 1 ] || return 0
	procd_open_instance "$cfg"
	procd_set_param command /usr/share/udpspeeder-luci/run.sh "$cfg"
	# Detect changes without exposing the key in the service list.
	procd_set_param data config "$( { uci -q show "udpspeeder.$cfg"; uci -q show udpspeeder.global; } | sha256sum | cut -d' ' -f1)"
	procd_set_param respawn 3600 5 5
	procd_set_param term_timeout 5
	procd_set_param stdout 0
	procd_set_param stderr 1
	procd_close_instance
}

start_dns_monitor() {
	procd_open_instance dns-monitor
	procd_set_param command /usr/share/udpspeeder-luci/monitor.sh
	procd_set_param respawn
	procd_set_param term_timeout 5
	procd_close_instance
}

start_service() {
	local target="$1"
	umask 077
	mkdir -p "$STATE_DIR"
	# A core-package upgrade may have enabled its legacy init again.
	stop_if_registered udpspeeder || return 1
	/etc/init.d/udpspeeder disable 2>/dev/null
	config_load udpspeeder
	if [ -n "$target" ]; then
		start_instance "$target"
	else
		config_foreach start_instance udpspeeder
	fi
	# Also include the monitor in additive single-rule starts, so enabling the
	# first domain rule starts it without restarting unrelated rule instances.
	if dns_monitor_needed; then
		start_dns_monitor
	fi
}

stop_unused_dns_monitor() {
	local info
	config_load udpspeeder
	dns_monitor_needed && return 0
	# Remove registered monitors even while they are waiting for respawn.
	info=$(ubus call service list '{"name":"udpspeeder-luci"}') || return 1
	case "$info" in *\"dns-monitor\"*) stop dns-monitor ;; esac
}

# Run after rc.common has submitted the service JSON to procd. Stopping an
# instance inside start_service() would overwrite that pending JSON request.
service_started() {
	stop_unused_dns_monitor
}

service_triggers() {
	procd_add_reload_trigger udpspeeder
}

check_rule() {
	valid_id "$1" && [ "$(uci -q get "udpspeeder.$1")" = udpspeeder ] || {
		echo 'Unknown rule' >&2; return 1;
	}
}

rule_start() {
	check_rule "$1" || return 1
	uci set "udpspeeder.$1.enabled=1" && uci commit udpspeeder || return 1
	start "$1"
}

rule_stop() {
	check_rule "$1" || return 1
	uci set "udpspeeder.$1.enabled=0" && uci commit udpspeeder || return 1
	stop "$1"
	rm -f "$STATE_DIR/$1.status" "$STATE_DIR/$1.resolved"
	stop_unused_dns_monitor
}

restart_instance() {
	local cfg="$1" attempt
	stop "$cfg"
	for attempt in 1 2 3 4 5; do
		procd_running udpspeeder-luci "$cfg" || break
		sleep 1
	done
	if procd_running udpspeeder-luci "$cfg"; then
		echo 'Previous instance is still stopping' >&2
		return 1
	fi
	start "$cfg"
}

rule_restart() {
	check_rule "$1" || return 1
	uci set "udpspeeder.$1.enabled=1" && uci commit udpspeeder || return 1
	restart_instance "$1"
}

# DNS monitor uses this action without altering persistent enable flags.
refresh_rule() {
	check_rule "$1" || return 1
	[ "$(uci -q get "udpspeeder.$1.enabled")" = 1 ] || return 0
	restart_instance "$1"
}

rule_status() {
	check_rule "$1" || return 1
	[ ! -f "$STATE_DIR/$1.status" ] || cat "$STATE_DIR/$1.status"
	printf '\n'
	[ ! -f "$STATE_DIR/$1.resolved" ] || cat "$STATE_DIR/$1.resolved"
}

rule_log() {
	check_rule "$1" || return 1
	[ ! -f "$STATE_DIR/$1.log" ] || tail -n 1000 "$STATE_DIR/$1.log"
}

EXTRA_COMMANDS="rule_start rule_stop rule_restart refresh_rule rule_status rule_log"
